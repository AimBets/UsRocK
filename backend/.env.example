# UsRock backend — variáveis de ambiente
# Copie para `backend/.env` (ignorado pelo Git) e ajuste. Nunca commite credenciais reais.
# Todas as variáveis são validadas na inicialização (src/config/env.ts); valores inválidos
# impedem o servidor de subir e o erro lista apenas o NOME da variável, nunca o valor.

# --- Execução ---------------------------------------------------------------
# development | test | production
NODE_ENV=development
# Interface de escuta. Em contêiner/produção use 0.0.0.0.
HOST=127.0.0.1
PORT=3333
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Identificador da versão implantada, exibido em /api/v1/health (ex.: SHA do commit).
APP_VERSION=development

# --- Banco de dados ---------------------------------------------------------
# Credenciais abaixo são as do docker-compose local, válidas só na máquina do desenvolvedor.
# A porta do host é 5433 para não conflitar com outro PostgreSQL local (ajuste com POSTGRES_HOST_PORT).
DATABASE_URL=postgres://usrock:usrock_dev_only@127.0.0.1:5433/usrock
# Conexões máximas do pool por processo.
DATABASE_POOL_MAX=10
# Banco usado pela suíte de integração. DEVE terminar em `_test`: ele é apagado a cada execução.
TEST_DATABASE_URL=postgres://usrock:usrock_dev_only@127.0.0.1:5433/usrock_test

# --- HTTP e segurança -------------------------------------------------------
# Origens de navegador autorizadas (CORS e verificação de Origin em requisições que alteram dados),
# separadas por vírgula. Em produção, apenas https.
CORS_ORIGINS=http://localhost:3000
# true somente quando atrás de proxy/load balancer confiável (afeta IP usado no rate limit).
TRUST_PROXY=false
# Requisições por janela, por IP (rate limit global; rotas sensíveis terão limites próprios).
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
# Documentação Swagger em /docs. Padrão: ligada em development, desligada em production.
API_DOCS_ENABLED=true

# --- Contas e sessão (E3) ---------------------------------------------------
# Origem pública da loja (frontend), usada nos links enviados por e-mail. Em produção, https.
APP_PUBLIC_URL=http://localhost:3000
# Cookie de sessão com atributo Secure. Padrão: true em production, false fora dela.
# SESSION_COOKIE_SECURE=false
# Validade absoluta da sessão e expiração por inatividade, em dias.
SESSION_TTL_DAYS=30
SESSION_IDLE_DAYS=14
# Tentativas por 15 min, por IP, em login/cadastro/senha (o login também limita por e-mail).
AUTH_RATE_LIMIT_MAX=10
# Versão dos Termos de Uso/Política de Privacidade registrada no consentimento do cadastro.
# Os textos jurídicos ainda NÃO existem; atualize quando forem publicados.
LEGAL_POLICY_VERSION=rascunho-2026-10

# --- E-mail -----------------------------------------------------------------
# Desenvolvimento: Mailpit do docker-compose (nada sai da máquina; veja http://127.0.0.1:8025).
# Produção: provedor transacional a definir; credenciais apenas no ambiente seguro.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
MAIL_FROM=UsRock <nao-responda@usrock.local>

# --- Comando user:create-admin ----------------------------------------------
# Senha do administrador criado pelo comando. Obrigatória em produção; fora dela, se ausente,
# uma senha aleatória é gerada e exibida uma vez. Não deixe este valor salvo após o uso.
# ADMIN_PASSWORD=

# --- Integrações futuras (ainda NÃO utilizadas) ------------------------------
# Mantidas apenas como referência; serão validadas quando o módulo correspondente existir.
# Use sempre credenciais de SANDBOX em desenvolvimento.
# MERCADO_PAGO_ACCESS_TOKEN=
# MERCADO_PAGO_WEBHOOK_SECRET=
# SUPERFRETE_API_TOKEN=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
